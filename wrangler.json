{
  "name": "hostia-vitrine",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-26",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./out",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/monitoring",
      "/monitoring/"
    ]
  }
}
